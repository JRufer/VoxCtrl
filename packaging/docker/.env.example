# Settings for packaging/docker/docker-compose.yml. Copy to `.env` and edit.
# Every line is optional; the value shown is the default.

# Which speech engine and model the server runs. See docs/server.md for the
# full list. Parakeet is the default here because it is fast without a GPU.
#   parakeet     tdt-0.6b-v3 | tdt-0.6b-v3-int8 | tdt-0.6b-v3-redux | phonon-2
#   whisper-cpp  tiny | base | small | medium | large-v3 | large-v3-turbo (and .en variants)
#   moonshine    tiny | base
VOXCTRL_SERVER_BACKEND=parakeet
VOXCTRL_SERVER_MODEL=tdt-0.6b-v3

# Language code such as en, or blank for the engine's default.
VOXCTRL_SERVER_LANGUAGE=

# The key clients must present. Blank = generate one on first start and print
# it once in `docker compose logs`.
VOXCTRL_SERVER_API_KEY=

# Port on the host.
VOXCTRL_SERVER_PORT=8787

# GPU (experimental, see docs/server.md): set to `vulkan` and rebuild, and use
# docker-compose.gpu.yml alongside the main compose file.
VOXCTRL_BUILD_FEATURES=
VOXCTRL_SERVER_DEVICE=
