# Maintainer: Josh Rufer <jrufer at gmail dot com>
#
# Source of truth: packaging/aur/voxctrl/PKGBUILD in github.com/JRufer/VoxCtrl.
# The AUR copy is pushed by .github/workflows/aur-publish.yml when a release is
# published; pkgver and the checksum below are filled in by
# packaging/aur/update-pkgbuilds.sh. Edit this file in the app repo, not on the AUR.
#
# Please report bugs on GitHub, not in AUR comments:
# https://github.com/JRufer/VoxCtrl/issues

pkgname=voxctrl
pkgver=0.8.8
pkgrel=1
pkgdesc='Private, on-device voice dictation and voice command router for Linux (Wayland and X11)'
arch=('x86_64')
url='https://jrufer.com/voxctrl'
license=('MIT')
depends=('alsa-lib' 'cairo' 'dbus' 'gcc-libs' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3'
         'hicolor-icon-theme' 'libayatana-appindicator' 'libsoup3' 'openssl'
         'vulkan-icd-loader' 'webkit2gtk-4.1' 'wtype' 'xdg-desktop-portal')
# clang: bindgen for whisper.cpp and llama.cpp. shaderc: glslc, which compiles
# ggml's Vulkan shaders at build time.
makedepends=('cargo' 'clang' 'cmake' 'git' 'nodejs' 'npm' 'pkgconf' 'shaderc' 'vulkan-headers')
optdepends=('xdotool: type transcriptions into windows on X11'
            'wl-clipboard: clipboard delivery on Wayland'
            'xclip: clipboard delivery on X11'
            'espeak-ng: instant fallback text-to-speech voice'
            'vulkan-driver: GPU acceleration for speech recognition and cleanup')
provides=('voxctrl')
conflicts=('voxctrl-bin' 'voxctrl-git')
# makepkg's -flto in CFLAGS/CXXFLAGS breaks the vendored whisper.cpp and
# llama.cpp CMake builds.
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/JRufer/VoxCtrl/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

# The same features as the -vulkan-webgpu release build.
_features='vulkan,moonshine-webgpu,parakeet-webgpu'

prepare() {
  cd "VoxCtrl-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  npm ci --no-audit --no-fund
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "VoxCtrl-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Reported by `voxctrl --version`; a tarball has no commit to read.
  export VOXCTRL_BUILD_SHA="v$pkgver"
  # The S1-mini sidecar keeps its Vulkan backend (scripts/build-sidecar.mjs).
  export VOXCTRL_SIDECAR_FEATURES=vulkan

  # What Tauri's beforeBuildCommand runs, then the app itself. Building with
  # cargo directly keeps the PKGBUILD independent of the Tauri CLI's flags.
  # Note: ort downloads its prebuilt ONNX Runtime (and Dawn) during this step,
  # so the build needs network access, as it does for the release workflow.
  node scripts/build-sidecar.mjs --release
  npm run build
  cargo build --frozen --release -p voxctrl-app --features "$_features"
}

package() {
  cd "VoxCtrl-$pkgver"
  install -Dm755 target/release/voxctrl             "$pkgdir/usr/bin/voxctrl"
  install -Dm755 target/release/voxctrl-llm-sidecar "$pkgdir/usr/bin/voxctrl-llm-sidecar"
  install -Dm755 "$(realpath target/release/libwebgpu_dawn.so)" \
    "$pkgdir/usr/lib/voxctrl/libwebgpu_dawn.so"

  install -Dm644 ai.voxctrl.app.desktop "$pkgdir/usr/share/applications/ai.voxctrl.app.desktop"
  install -Dm644 src-tauri/icons/32x32.png      "$pkgdir/usr/share/icons/hicolor/32x32/apps/voxctrl.png"
  install -Dm644 src-tauri/icons/128x128.png    "$pkgdir/usr/share/icons/hicolor/128x128/apps/voxctrl.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/voxctrl.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
