# Maintainer: Josh Rufer <jrufer at gmail dot com>
#
# Source of truth: packaging/aur/voxctrl-git/PKGBUILD in github.com/JRufer/VoxCtrl.
# Builds the tip of master. Not updated per release (pkgver() follows the
# branch); push it to the AUR by hand only when its build steps change.
#
# Please report bugs on GitHub, not in AUR comments:
# https://github.com/JRufer/VoxCtrl/issues

pkgname=voxctrl-git
pkgver=0.8.8.r0.g0000000
pkgrel=1
pkgdesc='Private, on-device voice dictation and voice command router for Linux (development version)'
arch=('x86_64')
url='https://jrufer.com/voxctrl'
license=('MIT')
depends=('alsa-lib' 'cairo' 'dbus' 'gcc-libs' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3'
         'hicolor-icon-theme' 'libayatana-appindicator' 'libsoup3' 'openssl'
         'vulkan-icd-loader' 'webkit2gtk-4.1' 'xdg-desktop-portal')
makedepends=('cargo' 'clang' 'cmake' 'git' 'nodejs' 'npm' 'pkgconf' 'shaderc' 'vulkan-headers')
optdepends=('wtype: type transcriptions into windows on Wayland'
            'xdotool: type transcriptions into windows on X11'
            'wl-clipboard: clipboard delivery on Wayland'
            'xclip: clipboard delivery on X11'
            'espeak-ng: instant fallback text-to-speech voice'
            'vulkan-driver: GPU acceleration for speech recognition and cleanup')
provides=('voxctrl')
conflicts=('voxctrl' 'voxctrl-bin')
options=('!lto' '!debug')
source=("$pkgname::git+https://github.com/JRufer/VoxCtrl.git#branch=master")
sha256sums=('SKIP')

_features='vulkan,moonshine-webgpu,parakeet-webgpu'

pkgver() {
  cd "$pkgname"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  npm ci --no-audit --no-fund
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  VOXCTRL_BUILD_SHA="$(git rev-parse HEAD)"
  export VOXCTRL_BUILD_SHA
  export VOXCTRL_SIDECAR_FEATURES=vulkan

  node scripts/build-sidecar.mjs --release
  npm run build
  cargo build --frozen --release -p voxctrl-app --features "$_features"
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/voxctrl             "$pkgdir/usr/bin/voxctrl"
  install -Dm755 target/release/voxctrl-llm-sidecar "$pkgdir/usr/bin/voxctrl-llm-sidecar"
  install -Dm755 "$(realpath target/release/libwebgpu_dawn.so)" \
    "$pkgdir/usr/lib/voxctrl/libwebgpu_dawn.so"

  install -Dm644 ai.voxctrl.app.desktop "$pkgdir/usr/share/applications/ai.voxctrl.app.desktop"
  install -Dm644 src-tauri/icons/32x32.png      "$pkgdir/usr/share/icons/hicolor/32x32/apps/voxctrl.png"
  install -Dm644 src-tauri/icons/128x128.png    "$pkgdir/usr/share/icons/hicolor/128x128/apps/voxctrl.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/voxctrl.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
